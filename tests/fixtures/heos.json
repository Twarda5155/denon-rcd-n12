{
  "_comment": "Recorded HEOS CLI responses keyed by command name. {pid}, {level}, {mute} and {state} are substituted from the fake's state before replay. '_now_playing' holds get_now_playing_media payloads recorded per HEOS source id, straight out of logs/device.log: 1024 is the foobar2000 DLNA share on the LAN, 3 is TuneIn. Note that the station payload fills in 'song' AND 'station' at once - the track on air and the station carrying it - which is why the client reports them as separate fields. The fake picks a payload by its now_playing_sid and replays an empty one when that is None.",
  "player/get_volume": {
    "heos": {
      "command": "player/get_volume",
      "result": "success",
      "message": "pid={pid}&level={level}"
    }
  },
  "player/set_volume": {
    "heos": {
      "command": "player/set_volume",
      "result": "success",
      "message": "pid={pid}&level={level}"
    }
  },
  "player/get_mute": {
    "heos": {
      "command": "player/get_mute",
      "result": "success",
      "message": "pid={pid}&state={mute}"
    }
  },
  "player/get_play_state": {
    "heos": {
      "command": "player/get_play_state",
      "result": "success",
      "message": "pid={pid}&state={state}"
    }
  },
  "player/get_now_playing_media": {
    "heos": {
      "command": "player/get_now_playing_media",
      "result": "success",
      "message": "pid={pid}"
    }
  },
