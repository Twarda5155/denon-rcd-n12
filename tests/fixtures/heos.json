{
  "_comment": "Recorded HEOS CLI responses keyed by command name. {pid}, {level} and {mute} are substituted from the fake's state before replay.",
  "player/get_volume": {
    "heos": {
      "command": "player/get_volume",
      "result": "success",
      "message": "pid={pid}&level={level}"
    }
  },
  "player/set_volume": {
    "heos": {
      "command": "player/set_volume",
      "result": "success",
      "message": "pid={pid}&level={level}"
    }
  },
  "player/get_mute": {
    "heos": {
      "command": "player/get_mute",
      "result": "success",
      "message": "pid={pid}&state={mute}"
    }
  },
  "player/get_now_playing_media": {
    "heos": {
      "command": "player/get_now_playing_media",
      "result": "success",
      "message": "pid={pid}"
    },
    "payload": {
      "type": "song",
      "song": "W oczekiwaniu wiosny",
      "album": "Dlugosz",
      "artist": "Leszek Dlugosz",
      "album_id": "0/0/0",
      "mid": "0/0/0/2I",
      "qid": 5,
      "sid": 1024
    }
  }
}
